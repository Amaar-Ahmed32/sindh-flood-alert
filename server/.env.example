# ========================================================
# Sindh STREAM 2026-27: Environment Variables Template
# ========================================================

# Port for the Express backend server
PORT=5050

# MongoDB Connection String (Local mongod or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/sindh_stream_warning
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sindh_stream_warning
MONGODB_URI=mongodb://127.0.0.1:27017/sindh_stream_warning

# Cron schedule for background sync (Default: Every 30 minutes)
# Format: minute hour day-of-month month day-of-week
SYNC_CRON_SCHEDULE=*/30 * * * *

# Frontend client URL for CORS allowlist
CLIENT_URL=http://localhost:5173
